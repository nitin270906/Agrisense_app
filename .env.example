# Copy to .env and adjust. Every value below has a working default —
# the app runs with no .env at all, which is deliberate for demo safety.

APP_NAME="AI Salinity & Crop Stress Forecaster"
DATABASE_URL="sqlite:///./salinity.db"

# Weather provider: "open_meteo" (no key required) | "openweathermap" (needs key)
WEATHER_PROVIDER="open_meteo"
OPENWEATHERMAP_API_KEY=""

# Hours before a cached weather row is considered stale.
# On network failure we serve stale data anyway rather than fail the request.
WEATHER_CACHE_TTL_HOURS=3

# Comma-separated. Only used when frontend is served from a different origin.
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
